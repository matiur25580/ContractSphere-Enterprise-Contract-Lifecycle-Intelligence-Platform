NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
MONGODB_URI=mongodb://127.0.0.1:27017/contractsphere
JWT_ACCESS_SECRET=replace-this-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Private S3-compatible document storage (required for upload/download and document analysis)
S3_BUCKET=contractsphere-private
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=replace-with-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-storage-secret
# Optional for MinIO or another S3-compatible provider
# S3_ENDPOINT=http://localhost:9000

# Optional OpenAI-compatible provider. Without AI_API_KEY, only rules-based analysis is available.
# Contract text sent to this provider leaves your infrastructure; configure an approved provider and review its data retention terms.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

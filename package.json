{
  "name": "contractsphere",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Contract Lifecycle Intelligence Platform",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @contractsphere/api run dev",
    "dev:web": "npm --workspace @contractsphere/web run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "screenshots": "node scripts/capture-dashboard.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^7.0.2",
    "playwright": "^1.56.1"
  }
}
